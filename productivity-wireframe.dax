Productivity Wireframe HTML =
// Static wireframe snapshot for regular HTML Content.
// No model tables, JavaScript or external assets required.
VAR HtmlPart1 = "<style>#productivity-wireframe{--teal:#5D7A38;--ink:#404246;--muted:#5f6165;--lime:#B5C427}#productivity-wireframe *{box-sizing:border-box}#productivity-wireframe{margin:0;background:#e9ecee;color:var(--ink);font-family:Aptos,Arial,sans-serif}#productivity-wireframe .tools,#productivity-wireframe .option-nav{display:flex;align-items:center;gap:8px;margin:12px 20px;font-size:12px}#productivity-wireframe .tools{justify-content:space-between}#productivity-wireframe .tools button,#productivity-wireframe .option-nav button{font:600 12px Aptos,Arial,sans-serif;padding:8px 12px;border:1px solid #c5d3d6;background:white;border-radius:4px;cursor:pointer}#productivity-wireframe .option-nav button[aria-pressed=true]{background:var(--teal);color:white}#productivity-wireframe .option-nav>span{margin-right:8px}#productivity-wireframe .canvas-stage{position:relative;margin:0 auto 20px}#productivity-wireframe .sheet{width:3508px;height:2480px;padding:36px;background:white;display:grid;grid-template-rows:250px 270px 80px minmax(0,1fr) 40px;gap:22px;transform-origin:top left;position:absolute;top:0;left:0;overflow:hidden}#productivity-wireframe .option-page[hidden]{display:none}#productivity-wireframe header{min-height:0}#productivity-wireframe .masthead{height:100%;background:var(--teal);padding:24px 32px 0;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto 1fr;border-bottom:12px solid var(--ink)}#productivity-wireframe h1{font-size:70px;letter-spacing:-1px;line-height:1.1;color:white;margin:0}#productivity-wireframe .subtitle{font-size:32px;margin:8px 0;color:#e5f1f1}#productivity-wireframe .navigation-note{font-size:25px;text-align:right;color:#e5f1f1;grid-column:2;grid-row:1/3;align-self:center;margin:0}#productivity-wireframe .tabs{grid-column:1/-1;display:flex;justify-content:flex-end;align-items:end;gap:6px;background:var(--lime);margin:12px -32px 0;padding-top:8px}#productivity-wireframe .tab{font:600 30px Aptos,Arial,sans-serif;padding:18px 35px;border:0;border-radius:16px 16px 0 0;color:var(--ink);background:#d8e0e0}#productivity-wireframe .tab.active{background:white}#productivity-wireframe .tab:disabled{opacity:1}#productivity-wireframe .metrics{display:grid;grid-template-columns:1fr 2fr;gap:28px}#productivity-wireframe .metric-group{background:#eef5f5;border-top:7px solid var(--teal);padding:22px 28px}#productivity-wireframe .metric-group h2{font-size:36px;margin:0 0 22px}#productivity-wireframe .numbers{display:grid;grid-template-columns:1fr 1fr;gap:24px}#productivity-wireframe .value{font-size:68px;line-height:1.05;letter-spacing:-1px;margin:0 0 14px}#productivity-wireframe .period{font-size:27px;line-height:1.3}#productivity-wireframe .productivity-subgroups{display:grid;grid-template-columns:1fr 1fr}#productivity-wireframe .productivity-subgroup{padding-right:34px}#productivity-wireframe .productivity-subgroup+.productivity-subgroup{padding:0 0 0 34px;border-left:2px solid #c4d8da}#productivity-wireframe .productivity-subgroup h3{font-size:28px;color:#48646b;margin:0 0 16px}#productivity-wireframe .metrics>.metric-group:not(.productivity-group) .numbers{padding-top:49px}#productivity-wireframe .definitions{font-size:24px;line-height:1.4;color:#607078;margin:0;align-self:center}#productivity-wireframe .definitions a,#productivity-wireframe .source a{color:inherit;text-decoration-color:#b6c9ce}#productivity-wireframe .charts{display:grid;grid-template-columns:1fr 1.15fr;grid-template-rows:repeat(2,minmax(0,1fr));grid-template-areas:""comparison industries"" ""outlook industries"";gap:30px;min-height:0}#productivity-wireframe .comparison-panel{grid-area:comparison}#productivity-wireframe .outlook-panel{grid-area:outlook}#productivity-wireframe .industries-panel{grid-area:industries}#productivity-wireframe .market-panel{grid-area:market}#productivity-wireframe .economy-panel{grid-area:economy}#productivity-wireframe .split-charts{grid-template-rows:repeat(3,minmax(0,1fr));grid-template-areas:""market industries"" ""economy industries"" ""outlook industries""}#productivity-wireframe .chart-panel{min-width:0;min-height:0}#productivity-wireframe .visual-card{height:100%;display:flex;flex-direction:column;border:1px solid #d8e2e4;border-radius:0;padding:16px 20px;gap:10px;min-height:0}#productivity-wireframe .chart-heading{flex:none}#productivity-wireframe .headline{font-size:38px;line-height:1.18;letter-spacing:-.4px;margin:0}#productivity-wireframe .chart-subtitle{font-size:27px;line-height:1.25;color:#61737a;margin:8px 0 0}#productivity-wireframe .plot{display:block;width:100%;height:100%;flex:1 1 0;min-height:0;overflow:visible}#productivity-wireframe .grid path{stroke:#e2e9eb;stroke-width:2}#productivity-wireframe .plot text{fill:#5f6165;font-family:Aptos,Arial,sans-serif}#productivity-wireframe .chart-key{display:flex;align-items:center;gap:30px;flex:none;font-size:24px;min-height:26px}#productivity-wireframe .chart-key:empty,#productivity-wireframe .industries-panel .chart-key{display:none}#productivity-wireframe .chart-key span:before{content:'';display:inline-block;width:25px;height:6px;background:var(--key);vertical-align:middle;margin-right:10px}#productivity-wireframe .chart-key .dashed-key:before{height:0;background:none;border-top:5px dashed var(--key)}#productivity-wireframe .source{flex:none;border-top:1px solid #dce5e7;padding-top:8px;margin:0;font-size:23px;line-height:1.25;color:#64737a}#productivity-wireframe .split-charts .headline{font-size:34px}#productivity-wireframe .split-charts .source{font-size:22px}#productivity-wireframe footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #dce5e7;font-size:24px}#productivity-wireframe footer strong{font-size:26px;color:#62165C}#productivity-wireframe button:focus-visible{outline:3px solid #cc8c27;outline-offset:2px}#productivity-wireframe .chart-footnote{flex:none;border-top:1px solid #dce5e7;padding-top:9px;display:grid;gap:5px}#productivity-wireframe .measure-note{font-size:24px;line-height:1.25;color:#5f6165;margin:0}#productivity-wireframe .chart-footnote .source{border-top:0;padding-top:0;font-size:23px;line-height:1.25}#productivity-wireframe .split-charts .measure-note,#productivity-wireframe .split-charts .chart-footnote .source{font-size:22px}#productivity-wireframe .chart-heading{margin-bottom:0}#productivity-wireframe .visual-card{gap:8px}#productivity-wireframe .visual-card{border:0;padding:18px 24px;gap:10px}#productivity-wireframe .headline{font-size:38px;line-height:1.12;color:#404246}#productivity-wireframe .split-charts .headline{font-size:36px}#productivity-wireframe .plot text{fill:#404246;font-family:Aptos,Arial,sans-serif}#productivity-wireframe .grid path{stroke:#D7D8D8;stroke-width:2}#productivity-wireframe .source,#productivity-wireframe .chart-footnote .source,#productivity-wireframe .metric-source{font-style:italic}#productivity-wireframe .market-panel .plot,#productivity-wireframe .economy-panel .plot,#productivity-wireframe .outlook-panel .plot{flex:0 0 225px;height:225px}#productivity-wireframe .split-charts .measure-note{font-size:28px}#productivity-wireframe .split-charts .chart-footnote .source{font-size:26px}#productivity-wireframe .chart-footnote{border-top:1px solid #D7D8D8}#productivity-wireframe .endpoint-label{font-weight:700;fill:#5D7A38!important}#productivity-wireframe .sheet{grid-template-rows:250px 305px 65px minmax(0,1fr) 40px}#productivity-wireframe .metric-source{font-size:22px;margin:16px 0 0;color:#607078}#productivity-wireframe .metric-source a{color:inherit}#productivity-wireframe .metric-group{padding-top:18px}#productivity-wireframe .metric-group h2{margin-bottom:14px}#productivity-wireframe .value{margin-bottom:10px}#productivity-wireframe .navigation-note{display:none}#productivity-wireframe .implementation-notes{max-width:1180px;margin:24px auto 40px;padding:24px 28px;border:1px solid #b8ced1;border-left:5px solid #5D7A38;background:#fff;border-radius:6px;font-size:14px;line-height:1.55}#pro"
VAR HtmlPart2 = "ductivity-wireframe .implementation-notes h2{font-size:21px;margin:0 0 6px}#productivity-wireframe .notes-intro{margin:0 0 20px;color:#5f6165}#productivity-wireframe .notes-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 30px}#productivity-wireframe .notes-grid h3{font-size:15px;margin:0 0 5px;color:#087078}#productivity-wireframe .notes-grid p{margin:0}#productivity-wireframe .notes-grid .notes-caution{font-size:13px;margin-top:8px;color:#835c26}#productivity-wireframe .notes-checks{border-top:1px solid #dce5e7;padding-top:16px;margin:20px 0 0}#productivity-wireframe .notes-status{color:#64737a;font-size:12px;margin:12px 0 0}#productivity-wireframe .oce-review{border-top:1px solid #dce5e7;margin-top:24px;padding-top:20px}#productivity-wireframe .oce-review h3{font-size:18px;margin:0 0 10px}#productivity-wireframe .oce-review ul{padding-left:22px;margin:0}#productivity-wireframe .oce-review li{margin-bottom:12px}#productivity-wireframe .oce-review code{font-size:12px}#productivity-wireframe .canvas-stage{overflow:hidden;max-width:calc(100vw - 24px)}#productivity-wireframe .sheet{grid-template-rows:230px 290px 58px minmax(0,1fr) 40px}#productivity-wireframe .visual-card{display:flex;flex-direction:column;padding:12px 20px;gap:12px;overflow:hidden}#productivity-wireframe .chart-heading{flex:none}#productivity-wireframe .split-charts .headline{font-size:38px;line-height:1.16}#productivity-wireframe .chart-footnote{flex:none;padding-top:10px}#productivity-wireframe .split-charts .measure-note{font-size:27px}#productivity-wireframe .split-charts .chart-footnote .source{font-size:25px}#productivity-wireframe .html-line-chart{position:relative;flex:1 1 0;min-height:180px;width:100%;font-size:32px;color:#404246}#productivity-wireframe .line-area{position:absolute;left:76px;right:125px;top:24px;bottom:48px}#productivity-wireframe .line-grid{position:absolute;left:0;right:0;height:2px;background:#D7D8D8}#productivity-wireframe .line-grid.baseline{background:#A4A7A9;height:3px}#productivity-wireframe .line-y{position:absolute;right:calc(100% + 16px);transform:translateY(-50%);line-height:1;white-space:nowrap}#productivity-wireframe .line-x{position:absolute;top:calc(100% + 16px);transform:translateX(-50%);line-height:1}#productivity-wireframe .line-segment{position:absolute;background:#5D7A38;height:6px;transform-origin:0 50%;border-radius:3px}#productivity-wireframe .line-dot{position:absolute;width:14px;height:14px;border-radius:50%;background:#5D7A38;transform:translate(-50%,-50%)}#productivity-wireframe .line-end-label{position:absolute;left:calc(100% + 16px);transform:translateY(-50%);font-weight:700;color:#5D7A38;white-space:nowrap}#productivity-wireframe .html-industry-chart{flex:1 1 0;min-height:0;display:grid;grid-template-rows:repeat(19,minmax(0,1fr));padding:20px 70px 10px 0}#productivity-wireframe .industry-row{display:grid;grid-template-columns:48% 52%;gap:28px;align-items:center;min-height:0}#productivity-wireframe .industry-name{font-size:32px;line-height:1.08;text-align:right;padding-right:12px}#productivity-wireframe .industry-track{position:relative;height:100%;min-height:0}#productivity-wireframe .industry-zero{position:absolute;top:0;bottom:0;width:2px;background:#A4A7A9}#productivity-wireframe .industry-bar{position:absolute;top:28%;height:44%;min-width:0}#productivity-wireframe .industry-value{position:absolute;top:50%;font-size:32px;line-height:1;white-space:nowrap}#productivity-wireframe .industry-value.positive{transform:translate(12px,-50%)}#productivity-wireframe .industry-value.negative{transform:translate(calc(-100% - 12px),-50%)}#productivity-wireframe .chart-heading .measure-note{margin-top:8px;color:#404246}#productivity-wireframe .title-automation{margin-top:12px;padding:10px 16px;border-left:5px solid #62165C;background:#F4EEF3;color:#404246;font-size:25px;line-height:1.25}#productivity-wireframe .title-automation strong{color:#62165C;font-weight:600}#productivity-wireframe .charts{grid-template-columns:1fr 1.3fr}#productivity-wireframe .chart-heading .title-automation{margin-top:8px}#productivity-wireframe .chart-heading .measure-note{margin-top:8px}#productivity-wireframe .metrics{gap:12px;background:#dcebec}#productivity-wireframe .metric-group{background:#dcebec;border-top:0;padding:18px 24px}#productivity-wireframe .metric-group+.metric-group{border-left:3px solid #fff}#productivity-wireframe .metric-group h2{font-size:36px;margin:0 0 14px;color:#25383d}#productivity-wireframe .productivity-subgroup h3{color:#25383d;font-weight:600}#productivity-wireframe .productivity-subgroup+.productivity-subgroup{border-left:2px solid #b9ced0}#productivity-wireframe .value{font-weight:400;color:#182c32}#productivity-wireframe .period{color:#25383d}#productivity-wireframe .metric-source{color:#40585e;margin-top:16px}#productivity-wireframe{background:#fff}#productivity-wireframe .canvas-stage{margin:0 auto;max-width:100vw}#productivity-wireframe .sheet{grid-template-rows:290px 58px minmax(0,1fr) 40px}#productivity-wireframe .metrics{grid-template-columns:0.8fr 2.2fr}#productivity-wireframe .productivity-subgroup .numbers{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}#productivity-wireframe .productivity-subgroup .period{font-size:24px}#productivity-wireframe .productivity-subgroup{padding-right:22px}#productivity-wireframe .productivity-subgroup+.productivity-subgroup{padding-left:22px}#productivity-wireframe .sheet{grid-template-rows:320px 58px minmax(0,1fr) 40px}
#productivity-wireframe{width:3508px;height:2480px;position:relative;overflow:hidden;margin:0;background:white;}#productivity-wireframe .sheet{position:relative;transform:none;margin:0;}</style><div id=""productivity-wireframe""><main class=""sheet option-page"" id=""page-1"" aria-label=""Productivity dashboard"">
<section class=""metrics"" aria-label=""Key indicators""><div class=""metric-group""><h2>Gross Domestic Product</h2><div class=""numbers""><div><div class=""value"">+0.4%</div><div class=""period"">over the quarter to June 2026</div></div><div><div class=""value"">+2.1%</div><div class=""period"">over the year to June 2026</div></div></div><p class=""metric-source"">Source: <a href=""https://www.abs.gov.au/statistics/economy/national-accounts/australian-national-accounts-national-income-expenditure-and-product/jun-2026"">ABS National Accounts · Table 1</a></p></div><div class=""metric-group productivity-group""><h2>Labour productivity</h2><div class=""productivity-subgroups""><div class=""productivity-subgroup""><h3>Market sector</h3><div class=""numbers""><div><div class=""value"">+0.2%</div><div class=""period"">over the quarter to June 2026</div></div><div><div class=""value"">−0.1%</div><div class=""period"">over the year to June 2026</div></div><div><div class=""value"">−0.2%</div><div class=""period"">2024–25 compared with 2023–24</div></div></div></div><div class=""productivity-subgroup""><h3>Economy-wide</h3><div class=""numbers""><div><div class=""value"">0.0%</div><div class=""period"">over the quarter to June 2026</div></div><div><div class=""value"">−0.2%</div><div class=""period"">over the year to June 2026</div></div><div><div class=""value"">−0.7%</div><div class=""period"">2024–25 compared with 2023–24</div></div></div></div></div><p class=""metric-source"">Source: <a href=""https://www.abs.gov.au/statistics/economy/national-accounts/australian-national-accounts-national-income-expenditure-and-product/jun-2026"">ABS National Accounts · Table 1</a> · Financial year: <a href=""https://www.abs.gov.au/statistics/economy/national-accounts/australian-system-national-accounts/2024-25"">ABS Annual National Accounts 2024–25</a></p></div></section>
<p class=""definitions"">Labour productivity: output per hour worked — market-sector gross value added or economy-wide GDP. Quarterly and year-ended figures are seasonally adjusted; financial-year figures compare full financial years. 0.0% means nil or rounded to zero.</p>
<section class=""charts split-charts"" aria-label=""Productivity charts""><article class=""chart-pan"
VAR HtmlPart3 = "el market-panel""><div class=""visual-card""><div class=""chart-heading""><h2 class=""headline"">Market-sector labour productivity fell 0.2% over the year to June 2026</h2><div class=""title-automation""><strong>Title automation · </strong>Can automate “rose/fell”, the annual percentage change and reporting quarter from the latest data.</div><p class=""measure-note"">Market-sector output per hour worked · change from a year earlier (%) · seasonally adjusted</p></div><div class=""html-line-chart"" role=""img"" aria-label=""Market-sector labour productivity fell 0.2% over the year to June 2026; Change from a year earlier (%); seasonally adjusted, June 2016 to June 2026"" style=""flex:1 1 0""><div class=""line-area""><div class=""line-grid"" style=""top:283.0px""></div><div class=""line-y"" style=""top:283.0px"">-6</div><div class=""line-grid"" style=""top:226.4px""></div><div class=""line-y"" style=""top:226.4px"">-4</div><div class=""line-grid"" style=""top:169.79999999999998px""></div><div class=""line-y"" style=""top:169.79999999999998px"">-2</div><div class=""line-grid baseline"" style=""top:113.2px""></div><div class=""line-y"" style=""top:113.2px"">0</div><div class=""line-grid"" style=""top:56.6px""></div><div class=""line-y"" style=""top:56.6px"">2</div><div class=""line-grid"" style=""top:0.0px""></div><div class=""line-y"" style=""top:0.0px"">4</div><div class=""line-segment"" style=""left:0.0px;top:65.42151898734153px;width:31.000036061751334px;transform:rotate(-0.0015253072958952103rad)""></div><div class=""line-segment"" style=""left:31.0px;top:65.37423442449861px;width:34.35859057878933px;transform:rotate(-0.44583971832896013rad)""></div><div class=""line-segment"" style=""left:62.0px;top:50.55827186512128px;width:35.83701821638792px;transform:rotate(0.5255914957641109rad)""></div><div class=""line-segment"" style=""left:93.0px;top:68.53859095688712px;width:56.7533669860878px;transform:rotate(0.9929477328313131rad)""></div><div class=""l